  "title": "Truffle Mushroom Risotto",
  "description": "Arborio rice slow-simmered in rich vegetable broth with wild mushrooms, shaved parmesan, and white truffle glaze.",
  "prepMinutes": 15,
  "cookMinutes": 25,
  "servings": 4,
  "recipeType": "Main Dish",
