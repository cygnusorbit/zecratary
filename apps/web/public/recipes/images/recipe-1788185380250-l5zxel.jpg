cipeMaker.userRating.click(this, event)" onkeypress="window.WPRecipeMaker.userRating.click(this, event)" style="font-size: 1em;"><svg width="16px" height="16px" version="1.1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke="#969563" stroke-width="2" stroke-linejoin="round" d="M11.99,1.94c-.35,0-.67.19-.83.51l-2.56,5.2c-.11.24-.34.4-.61.43l-5.75.83c-.35.05-.64.3-.74.64-.11.34,0,.7.22.94l4.16,4.05c.19.19.27.45.22.7l-.98,5.72c-.06.35.1.7.37.9.29.21.66.24.98.08l5.14-2.71h0c.24-.13.51-.13.75,0l5.14,2.71c.32.16.69.13.98-.08.29-.21.43-.56.37-.9l-.98-5.72h0c-.05-.26.05-.53.22-.7l4.16-4.05h0c.26-.24.34-.61.22-.94s-.4-.58-.74-.64l-5.75-.83c-.26-.03-.48-.21-.61-.43l-2.56-5.2c-.16-.32-.48-.53-.83-.51,0,0-.02,0-.02,0Z"/></svg></span><span class="wprm-rating-star wprm-rating-star-5 wprm-rating-star-full" data-rating="5" data-color="#969563" role="button" tabindex="0" aria-label="Rate this recipe 5 out of 5 stars" onmouseenter="window.WPRecipeMaker.userRating.enter(this)" onfocus="window.WPRecipeMaker.userRating.enter(this)" onmouseleave="window.WPRecipeMaker.userRating.leave(this)" onblur="window.WPRecipeMaker.userRating.leave(this)" onclick="window.WPRecipeMaker.userRating.click(this, event)" onkeypress="window.WPRecipeMaker.userRating.click(this, event)" style="font-size: 1em;"><svg width="16px" height="16px" version="1.1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="none" stroke="#969563" stroke-width="2" stroke-linejoin="round" d="M11.99,1.94c-.35,0-.67.19-.83.51l-2.56,5.2c-.11.24-.34.4-.61.43l-5.75.83c-.35.05-.64.3-.74.64-.11.34,0,.7.22.94l4.16,4.05c.19.19.27.45.22.7l-.98,5.72c-.06.35.1.7.37.9.29.21.66.24.98.08l5.14-2.71h0c.24-.13.51-.13.75,0l5.14,2.71c.32.16.69.13.98-.08.29-.21.43-.56.37-.9l-.98-5.72h0c-.05-.26.05-.53.22-.7l4.16-4.05h0c.26-.24.34-.61.22-.94s-.4-.58-.74-.64l-5.75-.83c-.26-.03-.48-.21-.61-.43l-2.56-5.2c-.16-.32-.48-.53-.83-.51,0,0-.02,0-.02,0Z"/></svg></span><div class="wprm-recipe-rating-details wprm-block-text-normal"><span class="wprm-recipe-rating-average">4.94</span> from <span class="wprm-recipe-rating-count">30</span> votes</div></div></div>
<div class="content-wrapper">
  <p>
I’ve been making this Chicken Cobb Salad Recipe for YEARS and it’s still one of my favorite quick and easy meals! It’s flavorful, balanced in textures, and SO good. And as a busy mom of 3, I love that I can make it in under 40 minutes! With tons of veggies and 43 grams of protein, this Cobb salad is healthy, high protein, and perfect for the entire family.</p></div>
<img width="765" height="1148" src="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-765x1148.jpg" class="attachment-large size-large wp-post-image" alt="Close up of Chicken Cobb Salad recipe." decoding="async" loading="lazy" srcset="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-765x1148.jpg 765w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-200x300.jpg 200w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-768x1152.jpg 768w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-340x510.jpg 340w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-680x1020.jpg 680w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2-150x225.jpg 150w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-2.jpg 1530w" sizes="auto, (max-width: 765px) 100vw, 765px" />
</header><div class="entry-content">



<div class="wp-block-group has-body-color has-color-1-background-color has-text-color has-background has-link-color wp-elements-3d7d3f0141bc4093a77c27f9aeb31f06"><div class="wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained">
<h2 class="wp-block-heading" id="h-table-of-contents">Table of Contents</h2>



<ul class="wp-block-list">
<li><a href="#wprm-recipe-container-16033">Jump to Recipe</a></li>



<li><a href="#h-cobb-salad-recipe-ingredients">Ingredients</a></li>



<li><a href="#h-for-the-dressing">Dressing Options</a></li>



<li><a href="#Cobb-Salad-Recipe-Variations">Variations</a></li>



<li><a href="#How-to-Assemble-a-Cobb-Salad-With-Grilled-Chicken">How to Make a Chicken Cobb Salad</a></li>
</ul>
</div></div>



<h2 class="wp-block-heading" id="h-refreshingly-easy-chicken-cobb-salad">Refreshingly Easy Chicken Cobb Salad</h2>



<p>Think: a hearty, refreshing, high-protein flavorful salad in under 40 minutes. Crunchy lettuce, creamy avocado, boiled eggs, fresh tomatoes, corn, deliciously seasoned grilled chicken, and topped with a sprinkle of feta or blue cheese crumbles. All topped with a good drizzle of <a href="https://www.jaroflemons.com/10-minute-healthy-ranch-dressing/">healthy ranch dressing</a> (or store-bought. Your choice)!</p>



<p>I’m completely obsessed &#8211; this may truly be my most favorite salad ever! And if you make the chicken in advance (check out this post: <a href="https://www.jaroflemons.com/30-minute-roasted-chicken-leftovers-recipes/">30-Minute Roasted Chicken Leftovers Recipes</a>) or buy a rotisserie chicken at the grocery store, then you can basically make this deliciousness in about 20 minutes or less!</p>



<p>With 43 grams of protein, it’s my hands-down go-to recipe whenever I’m craving a crunchy, savory, hearty salad. If you’ve been looking for the best way to make a Cobb salad, this method has been tested, perfected, and is so quick and easy!</p>



<p><strong>You&#8217;ll Also Love:</strong> <a href="https://www.jaroflemons.com/spicy-southwest-salad/">Spicy Southwest&nbsp;Salad&nbsp;Recipe</a></p>



<figure class="wp-block-image size-large"><img loading="lazy" decoding="async" width="765" height="1148" src="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-765x1148.jpg" alt="Angled photo of healthy Chicken Cobb Salad." class="wp-image-169122" srcset="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-765x1148.jpg 765w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-200x300.jpg 200w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-768x1152.jpg 768w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-340x510.jpg 340w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-680x1020.jpg 680w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3-150x225.jpg 150w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-3.jpg 1530w" sizes="auto, (max-width: 765px) 100vw, 765px" /></figure>



<h2 class="wp-block-heading" id="h-cobb-salad-recipe-ingredients">Cobb Salad Recipe Ingredients</h2>



<p>An easy way to remember the ingredients for a Cobb salad is by using the acronym EAT COBB: eggs, avocado, tomato, corn, onion, bacon, and blue cheese.</p>



<p>Except in this case I swapped feta cheese for blue cheese (because I just wasn&#8217;t feeling it). Feel free to use anything you want! I also left out the onion and swapped it with a garnish of freshly chopped chives. So good!</p>



<ul class="wp-block-list">
<li><a href="https://butcherbox.pxf.io/c/1424067/1366393/16419" target="_blank" rel="noreferrer noopener nofollow">Chicken Breasts</a>&nbsp;(thinly sliced)</li>



<li>Avocado Oil</li>



<li><a href="https://www.amazon.com/Simply-Organic-All-Purpose-Seasoning-2-08-Ounce/dp/B000WR8TK4?crid=265NG5I26KPWA&amp;dib=eyJ2IjoiMSJ9.758FkIOwPKLSJGfsHUgPYTncqdwROv0GduUvuSzZujwt5fEsyRUoFJn1R13N7hoz762jbToLCLzcqgHOlyNrMukTQI9vkHd2EIflJuw3SDQJbCjmkJ6gUKPxeAwa9ym5if-eRl4Fz8cmtEHnjNhE_25XTNmXTgevLFv3cMSKYZKG3m7be5nbv4HqDkxGjgrG9xR8mDNU8wxrmEQv1WdysAWv-vctlMaDa3zrCrdnoEcdgxjO544Pe5eAH2UAstEQDn_iRyYTYcHISfgkL3tbm8wjUeTDmd1MU9yV_DTiMo0.1zfm-FMaNSnkw6sTMuJLLSxRyoQQwipTozlt4ihi5-c&amp;dib_tag=se&amp;keywords=organic%2Ball%2Bpurpose%2Bseasoning&amp;qid=1743432376&amp;sprefix=organic%2Ball%2Bpurpose%2Bseasoning%2Caps%2C127&amp;sr=8-1-spons&amp;sp_csd=d2lkZ2V0TmFtZT1zcF9hdGY&amp;th=1&amp;linkCode=ll1&amp;tag=jaofle-20&amp;linkId=d5b3ae391cdd7788c28f4503fcddf75d&amp;language=en_US&amp;ref_=as_li_ss_tl" target="_blank" rel="noreferrer noopener nofollow">All-Purpose Seasoning</a>&nbsp;(1 tsp salt, 2 tsp garlic, 1/2 tsp onion powder, 1 tsp smoked paprika, 1/2 tsp pepper)</li>



<li>Eggs</li>



<li>Uncured Bacon</li>



<li>Avocado</li>



<li>Grape Tomatoes, halved</li>



<li>Frozen Corn</li>



<li>Crumbled Feta&nbsp;(or blue cheese)</li>



<li>Chopped Romaine&nbsp;(or crispy lettuce of choice)</li>



<li>Chives&nbsp;(optional, to taste)</li>
</ul>



<figure class="wp-block-image size-full"><img loading="lazy" decoding="async" width="765" height="1148" src="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-Ingredients-1.jpg" alt="Ingredients in a healthy chicken cobb salad recipe." class="wp-image-169144" srcset="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-Ingredients-1.jpg 765w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-Ingredients-1-200x300.jpg 200w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-Ingredients-1-340x510.jpg 340w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-Ingredients-1-680x1020.jpg 680w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-Ingredients-1-150x225.jpg 150w" sizes="auto, (max-width: 765px) 100vw, 765px" /></figure>



<h2 class="wp-block-heading" id="h-for-the-dressing">For The Dressing</h2>



<p>Feel free to make the yogurt-based ranch dressing included in this recipe, use store-bought ranch, or any of the easy dressings below:</p>



<ul class="wp-block-list">
<li><a href="https://www.jaroflemons.com/10-minute-healthy-ranch-dressing/">10-Minute Healthy Ranch Dressing</a></li>



<li><a href="https://www.jaroflemons.com/creamy-lemon-tahini-dressing/">Creamy Lemon Tahini&nbsp;Dressing</a></li>



<li><a href="https://www.jaroflemons.com/3-ingredient-creamy-avocado-lime-dressing/">3 Ingredient Creamy Avocado Lime Dressing</a></li>



<li><a href="https://www.jaroflemons.com/vegan-turmeric-ginger-dressing/">Vegan Turmeric Ginger Dressing</a></li>



<li><a href="https://www.jaroflemons.com/southwest-salad-dressing/">Southwest Salad&nbsp;Dressing</a></li>



<li><a href="https://www.jaroflemons.com/honey-mustard-dressing-recipe/">Honey Mustard&nbsp;Dressing</a></li>
</ul>



<h2 class="wp-block-heading" id="Cobb-Salad-Recipe-Variations">Cobb Salad Recipe Variations</h2>



<p>This healthy Cobb salad is so easy to customize! Here are some of my favorite ways to switch it up:</p>



<ul class="wp-block-list">
<li><strong>Swap the protein:</strong> Instead of grilled chicken, try baked salmon, shrimp, turkey, or crispy tofu for a different twist!</li>



<li><strong>Dairy-free option:</strong> Simply leave out the blue cheese or swap it for a dairy-free cheese alternative.</li>



<li><strong>Extra crunch:</strong> Add crisp bacon, toasted almonds, or sunflower seeds for even more texture.</li>



<li><strong>More veggies:</strong> Skip the chicken and add chickpeas or extra avocado for a more plant-based Cobb salad. Toss in cucumber, bell peppers, or shredded carrots for extra color and nutrients!</li>



<li><strong>Spicy kick:</strong> Drizzle with buffalo sauce or a little sriracha for some heat!</li>
</ul>



<p>You&#8217;ll Also Love: <a href="https://www.jaroflemons.com/crispy-buffalo-chicken-bowls/">Crispy Buffalo Chicken Bowls</a></p>



<figure class="wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-4 is-layout-flex wp-block-gallery-is-layout-flex">
<figure class="wp-block-image size-large"><img loading="lazy" decoding="async" width="765" height="1148" data-id="169124" src="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-765x1148.jpg" alt="Layers of a cobb salad with grilled chicken." class="wp-image-169124" srcset="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-765x1148.jpg 765w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-200x300.jpg 200w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-768x1152.jpg 768w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-340x510.jpg 340w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-680x1020.jpg 680w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5-150x225.jpg 150w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-5.jpg 1530w" sizes="auto, (max-width: 765px) 100vw, 765px" /></figure>



<figure class="wp-block-image size-large"><img loading="lazy" decoding="async" width="765" height="1148" data-id="169123" src="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-765x1148.jpg" alt="Close up of cobb salad with grilled chicken." class="wp-image-169123" srcset="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-765x1148.jpg 765w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-200x300.jpg 200w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-768x1152.jpg 768w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-340x510.jpg 340w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-680x1020.jpg 680w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4-150x225.jpg 150w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-4.jpg 1530w" sizes="auto, (max-width: 765px) 100vw, 765px" /></figure>
</figure>



<h2 class="wp-block-heading" id="How-to-Assemble-a-Cobb-Salad-With-Grilled-Chicken">How to Assemble a Cobb Salad With Grilled Chicken</h2>



<p>This healthy Cobb salad comes together in just a few simple steps! Here’s how to assemble it:</p>



<ol start="1" class="wp-block-list">
<li><strong>Grill the chicken</strong> – Cook the chicken breasts on the stovetop until golden brown and fully cooked, about 10-15 minutes per side.</li>



<li><strong>Cook the bacon</strong> &#8211; I like to bake the bacon on a <a href="https://www.amazon.com/Caraway-Non-Stick-Ceramic-Baking-Cooling/dp/B0D8MWCTB1?crid=2237WA40MU9E7&amp;dib=eyJ2IjoiMSJ9.0IGvRDOaKdKcxKyG7x8jj_LBbmXQJqGt1tB7TJwaYVQVt2pVYuQ25yjEOSUpGnrZpsRW_HzrLzOG-pKIefw7xRBHbLAxA4HG_baPTlUQfveJLwbg2n7rj-6eN5anAXaU4fJX0JUDDJHMHyuvfVnGly_rUrnvEkd3J9y0h4m1hZAIOffWnJrPck5CF7Tr9eh5_m6H5m0mMlUbctsmgNJWUwM_4sIXvmSLxD_HEsYzuEeemhKJ9OsJAhDETjEHdC4KRWYbCBUgVkG-sC22ccPqNLcsNMw63OITNIGTKoVsjpscOAM0X_aM9cr36z2UXcCJ0HT6skNcLOXZ3xUbTRGtqWDB76wXTuE2z61McvbGqD6EW3uaAHI9CRnoHBWSi7ohi6H7zHXuMVY8mRRNppy_xWDPv0LJMHm9iFRs9Owpis8YO8fORDdDNgSL9gEqm437.pBIDu75lNU9H34gsjkl_OeHzd58FmJoEv4u3oAd84Bc&amp;dib_tag=se&amp;keywords=caraway%2Bsheet%2Bpan%2Brack&amp;qid=1741273626&amp;sprefix=caraway%2Bsheet%2Bpan%2Brac%2Caps%2C132&amp;sr=8-6&amp;th=1&amp;linkCode=ll1&amp;tag=jaofle-20&amp;linkId=bc7e4b26ebd38c0f39e393b07139859d&amp;language=en_US&amp;ref_=as_li_ss_tl" target="_blank" rel="noreferrer noopener nofollow">large sheet pan</a> with parchment paper for a hands-off, easy method!</li>



<li><strong>Boil the eggs</strong> – While the chicken cooks, hard boil the eggs, then peel and slice them into bite-sized pieces.</li>



<li><strong>Chop the veggies</strong> – Slice the avocado, halve the tomatoes, and drain the canned corn or sauté frozen corn.</li>



<li><strong>Assemble the salad</strong> – Start with a bed of freshly chopped lettuce, then layer on the grilled chicken, eggs, avocado, tomatoes, corn, and cheese crumbles.</li>



<li><strong>Serve &amp; enjoy!</strong> Drizzle with your favorite dressing, toss gently, and dig in. So good!</li>
</ol>



<figure class="wp-block-image size-large"><img loading="lazy" decoding="async" width="765" height="1148" src="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-765x1148.jpg" alt="Healthy Chicken Cobb Salad with dressing." class="wp-image-169120" srcset="https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-765x1148.jpg 765w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-200x300.jpg 200w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-768x1152.jpg 768w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-340x510.jpg 340w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-680x1020.jpg 680w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1-150x225.jpg 150w, https://www.jaroflemons.com/wp-content/uploads/2025/04/Healthy-Chicken-Cobb-Salad-1.jpg 1530w" sizes="auto, (max-width: 765px) 100vw, 765px" /></figure>



