ad!","breadcrumb":{"@id":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#primaryimage","url":"https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2025\/04\/Healthy-Chicken-Cobb-Salad-2.jpg","contentUrl":"https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2025\/04\/Healthy-Chicken-Cobb-Salad-2.jpg","width":1530,"height":2295,"caption":"Close up of Chicken Cobb Salad recipe."},{"@type":"BreadcrumbList","@id":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/www.jaroflemons.com\/"},{"@type":"ListItem","position":2,"name":"Food","item":"https:\/\/www.jaroflemons.com\/category\/food\/"},{"@type":"ListItem","position":3,"name":"Lunch","item":"https:\/\/www.jaroflemons.com\/category\/recipes\/lunch\/"},{"@type":"ListItem","position":4,"name":"Healthy Cobb Salad Recipe With Chicken"}]},{"@type":"WebSite","@id":"https:\/\/www.jaroflemons.com\/#website","url":"https:\/\/www.jaroflemons.com\/","name":"Jar Of Lemons","description":"","publisher":{"@id":"https:\/\/www.jaroflemons.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/www.jaroflemons.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/www.jaroflemons.com\/#organization","name":"Jar Of Lemons","url":"https:\/\/www.jaroflemons.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.jaroflemons.com\/#\/schema\/logo\/image\/","url":"https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2020\/04\/jol_organization_logo.jpg","contentUrl":"https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2020\/04\/jol_organization_logo.jpg","width":300,"height":300,"caption":"Jar Of Lemons"},"image":{"@id":"https:\/\/www.jaroflemons.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/JarOfLemons","https:\/\/x.com\/Jar_Of_Lemons","https:\/\/www.instagram.com\/jar.of.lemons","https:\/\/www.pinterest.com\/JarOfLemons","https:\/\/www.youtube.com\/c\/jaroflemons","https:\/\/www.tiktok.com\/@jaroflemons"]},{"@type":"Person","@id":"https:\/\/www.jaroflemons.com\/#\/schema\/person\/5bc94da71bac69874ddf416813a2b22b","name":"Christine","sameAs":["https:\/\/www.jaroflemons.com"],"url":"https:\/\/www.jaroflemons.com\/author\/krenikchristine\/"},{"@type":"Recipe","name":"Healthy Chicken Cobb With Avocado Salad","author":{"@id":"https:\/\/www.jaroflemons.com\/#\/schema\/person\/5bc94da71bac69874ddf416813a2b22b"},"description":"I’ve been making this Chicken Cobb Salad Recipe for YEARS and it’s still one of my favorite quick and easy meals! It’s flavorful, balanced in textures, and SO good. And as a busy mom of 3, I love that I can make it in under 40 minutes! With tons of veggies and 43 grams of protein, this Cobb salad is healthy, high protein, and perfect for the entire family.","datePublished":"2025-04-02T03:00:00+00:00","image":["https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2025\/04\/Healthy-Chicken-Cobb-Salad-2.jpg","https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2025\/04\/Healthy-Chicken-Cobb-Salad-2-500x500.jpg","https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2025\/04\/Healthy-Chicken-Cobb-Salad-2-500x375.jpg","https:\/\/www.jaroflemons.com\/wp-content\/uploads\/2025\/04\/Healthy-Chicken-Cobb-Salad-2-480x270.jpg"],"video":{"name":"Healthy Cobb Salad With Grilled Chicken","description":"I’ve been making this Chicken Cobb Salad Recipe for YEARS and it’s still one of my favorite quick and easy meals! It’s flavorful, balanced in textures, and SO good. And as a busy mom of 3, I love that I can make it in under 40 minutes! With tons of veggies and 43 grams of protein, this Cobb salad is healthy, high protein, and perfect for the entire family.\n\nRECIPE: https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/","uploadDate":"2025-04-02T07:15:08+00:00","duration":"PT17S","thumbnailUrl":"https:\/\/i.ytimg.com\/vi\/vUDfMjSA2j8\/hqdefault.jpg","embedUrl":"https:\/\/www.youtube.com\/embed\/vUDfMjSA2j8?feature=oembed","contentUrl":"https:\/\/www.youtube.com\/watch?v=vUDfMjSA2j8","@type":"VideoObject"},"recipeYield":["4","4 Servings"],"prepTime":"PT10M","cookTime":"PT30M","totalTime":"PT40M","recipeIngredient":["1 pound chicken breasts (thinly sliced)","1 Tablespoon avocado oil","1 1\/2 Tablespoons all-purpose seasoning (1 tsp salt, 2 tsp garlic, 1\/2 tsp onion powder, 1 tsp smoked paprika, 1\/2 tsp pepper)","4 large eggs","6-8 slices bacon (or more!)","1 large avocado","2 cups grape tomatoes, halved","1 cup frozen corn","1\/2 cup crumbled feta (or blue cheese)","6-8 cups chopped romaine (or crispy lettuce of choice)","finely chopped chives (optional, to taste)","1\/4 cup plain Greek yogurt","1-2 Tablespoons milk (adjust to thickness)","1\/4 teaspoon onion","1\/4 teaspoon garlic","1\/4 teaspoon salt","1\/4 teaspoon pepper","1\/4 teaspoon dill","1 teaspoon freshly chopped parsley","2 teaspoons Worcestershire sauce"],"recipeInstructions":[{"@type":"HowToStep","text":"Preheat the oven to 400 degrees F and prep a baking sheet with two sheets of parchment paper.","name":"Preheat Oven &amp; Prepare Baking Sheets","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-0"},{"@type":"HowToStep","text":"Add the avocado oil to a grill pan or cast-iron skillet over medium-high heat.","name":"Add Oil to Pan","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-1"},{"@type":"HowToStep","text":"Sprinkle the chicken breasts with seasoning and grill on the stove top for about 10-15 minutes on each side in your choice of oil.","name":"Grill Chicken","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-2"},{"@type":"HowToStep","text":"Meanwhile, place the bacon on a baking sheet with 2 sheets of parchment paper and cook in the oven for about 20 minutes (or until crispy).","name":"Cook Bacon in Oven","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-3"},{"@type":"HowToStep","text":"While the chicken is cooking, hard boil the eggs by placing them in 1 inch of water and bringing to a boil. Lower the heat and let simmer for about 7-8 minutes.","name":"Hard Boil Eggs","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-4"},{"@type":"HowToStep","text":"Remove the egg shells and cut the eggs into small pieces.","name":"Remove Shells &amp; Slice","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-5"},{"@type":"HowToStep","text":"Once the chicken is done cooking, set it aside and sauté the corn in the same pan (just until warm).","name":"Saute Corn","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-6"},{"@type":"HowToStep","text":"Pat the cooked bacon slices dry and cut into small bits.","name":"Chop Bacon","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-7"},{"@type":"HowToStep","text":"Slice the avocado and cut the tomatoes into halves.","name":"Slice Avocado &amp; Tomatoes","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-8"},{"@type":"HowToStep","text":"Top each plate of lettuce with sliced or cubed cooked chicken, eggs, bacon bits, avocado, tomatoes, corn, and feta crumbles.","name":"Assemble Salads","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-9"},{"@type":"HowToStep","text":"Whisk together the healthy ranch dressing ingredients and drizzle over each salad.","name":"Whisk Ranch Dressing","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-10"},{"@type":"HowToStep","text":"Serve &amp; enjoy!","name":"Enjoy","url":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#wprm-recipe-16033-step-0-11"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.94","ratingCount":"30","reviewCount":"7"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Absolutely phenomenal will be making weekly","author":{"@type":"Person","name":"Linda"},"datePublished":"2026-06-22"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Delicious chicken cobb salad, my picky eater enjoyed it.","author":{"@type":"Person","name":"Swathi"},"datePublished":"2025-04-19"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This was so good and the dressing was the perfect complement. Mine wasn't as pretty as yours, but I tried!","author":{"@type":"Person","name":"JEAN"},"datePublished":"2025-04-15"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"One of my favourite recipes on your blog that we made numerous times now. Love the crunch, the flavours, and the yogurt dressing.","author":{"@type":"Person","name":"Ieva"},"datePublished":"2025-04-15"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I adore a Cobb salad but this is the first I've ever made! It was SO delicious!!!","author":{"@type":"Person","name":"Liz"},"datePublished":"2025-04-14"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I love this healthier version of a classic. I've always enjoyed the chunky flavor and texture of a Cobb salad.","author":{"@type":"Person","name":"Nicole Kendrick"},"datePublished":"2025-04-14"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Absolutely love this cobb salad recipe! It's so easy to make. My family all loved it, too!","author":{"@type":"Person","name":"Jenny"},"datePublished":"2018-07-09"}],"recipeCategory":["Lunch, Dinner, Appetizer","Main Course","Salad"],"recipeCuisine":["American"],"suitableForDiet":["https:\/\/schema.org\/GlutenFreeDiet"],"keywords":"Cobb Salad Recipe, Grilled Chicken Salad, Healthy Chicken Cobb Salad","nutrition":{"@type":"NutritionInformation","servingSize":"4 Cups","calories":"592 kcal","carbohydrateContent":"26 g","proteinContent":"43 g","fatContent":"37 g","saturatedFatContent":"11 g","transFatContent":"0.1 g","cholesterolContent":"298 mg","sodiumContent":"841 mg","fiberContent":"9 g","sugarContent":"4 g","unsaturatedFatContent":"22 g"},"@id":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#recipe","isPartOf":{"@id":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/#article"},"mainEntityOfPage":"https:\/\/www.jaroflemons.com\/healthy-chicken-cobb-salad-recipe\/"}]}</script>
